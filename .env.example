# Default: no key, no remote call, deterministic extractive behavior.
DESIGNLENS_PROVIDER=extractive
DESIGNLENS_DB=data/designlens.sqlite3
# To run a real paid model, explicitly configure the fields below locally.
# DESIGNLENS_PROVIDER=openai-compatible
# DESIGNLENS_API_BASE=https://api.openai.com/v1
# DESIGNLENS_API_KEY=
# DESIGNLENS_MODEL=
# DESIGNLENS_ALLOW_REAL_REMOTE=0
# Environment files are not auto-loaded. Export these variables in your shell.
