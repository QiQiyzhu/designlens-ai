# Default: no key, no remote call, deterministic extractive behavior.
DESIGNLENS_PROVIDER=extractive
DESIGNLENS_DB=data/designlens.sqlite3
# To run a real paid model, explicitly configure the fields below locally.
# DESIGNLENS_PROVIDER=deepseek
# DESIGNLENS_API_BASE=https://api.deepseek.com
# DESIGNLENS_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=
# Optional project-specific key overrides DEEPSEEK_API_KEY:
# DESIGNLENS_API_KEY=
# DESIGNLENS_MAX_OUTPUT_TOKENS=768
# DESIGNLENS_TIMEOUT_SECONDS=30
# Keep real research local; only explicitly synthetic sources can be sent by default.
# Real cloud use also requires reviewed intake and current per-source approval in the UI.
# This global switch alone never authorizes a real source. Known identifiers remain blocked.
# DESIGNLENS_ALLOW_REAL_REMOTE=0
# Environment files are not auto-loaded. Export these variables in your shell.
